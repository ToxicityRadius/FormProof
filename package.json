{
  "name": "formproof",
  "version": "0.1.0",
  "description": "Evidence-gated web accessibility repair CLI",
  "type": "module",
  "bin": {
    "formproof": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixture:static": "node scripts/serve-fixture.mjs fixtures/static-label 4173",
    "fixture:react": "npm --prefix fixtures/react-label run dev -- --host 127.0.0.1 --port 4174 --strictPort",
    "fixture:flask": "fixtures\\flask-label\\.venv\\Scripts\\python.exe -m flask --app fixtures/flask-label/app.py run --host 127.0.0.1 --port 4175",
    "fixture:vue": "npm --prefix fixtures/vue-label run dev -- --host 127.0.0.1 --port 4176 --strictPort",
    "fixture:angular": "npm --prefix fixtures/angular-label run dev -- --host 127.0.0.1 --port 4177",
    "fixture:static-keyboard": "node scripts/serve-fixture.mjs fixtures/static-hidden-focus 4178",
    "fixture:react-keyboard": "npm --prefix fixtures/react-hidden-focus run dev -- --host 127.0.0.1 --port 4179 --strictPort",
    "fixture:vue-keyboard": "npm --prefix fixtures/vue-hidden-focus run dev -- --host 127.0.0.1 --port 4180 --strictPort",
    "fixture:flask-keyboard": "fixtures\\flask-hidden-focus\\.venv\\Scripts\\python.exe -m flask --app fixtures/flask-hidden-focus/app.py run --host 127.0.0.1 --port 4181"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
