{
  "name": "formproof",
  "version": "0.1.0",
  "description": "Evidence-gated web accessibility repair CLI",
  "type": "module",
  "bin": {
    "formproof": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixture:static": "node scripts/serve-fixture.mjs fixtures/static-label 4173"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
